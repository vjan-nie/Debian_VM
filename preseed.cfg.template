d-i debian-installer/locale string en_US
d-i keyboard-configuration/xkb-keymap select es
d-i netcfg/choose_interface select auto
d-i netcfg/get_hostname string debian
d-i netcfg/get_domain string 42.fr

# Mirror settings (Essential to avoid getting stuck)
d-i clock-setup/utc boolean true
d-i time/zone string Europe/Madrid
d-i mirror/country string manual
d-i mirror/http/hostname string deb.debian.org
d-i mirror/http/directory string /debian
d-i mirror/http/proxy string

# User and Root configuration
d-i passwd/root-login boolean true
d-i passwd/root-password password ${VM_PASSWORD}
d-i passwd/root-password-again password ${VM_PASSWORD}

# User conf without privileges
d-i passwd/user-fullname string ${VM_USER}
d-i passwd/username string ${VM_USER}
d-i passwd/user-password password ${VM_PASSWORD}
d-i passwd/user-password-again password ${VM_PASSWORD}
d-i user-setup/allow-password-weak boolean true

# User into sudo group
d-i passwd/user-default-groups string sudo

# Partition (20GB simple)
d-i partman-auto/method string regular
d-i partman-auto/choose_recipe select atomic
d-i partman-partitioning/confirm_write_new_label boolean true
d-i partman/choose_partition select finish
d-i partman/confirm boolean true
d-i partman/confirm_nooverwrite boolean true
d-i partman-auto/disk string /dev/sda

# Basic packages + SSH
tasksel tasksel/first multiselect standard, ssh-server
d-i pkgsel/include string sudo ufw apparmor curl make git ca-certificates
d-i pkgsel/include string sudo curl make git ca-certificates xfce4 lightdm firefox-esr
d-i grub-installer/only_debian boolean true
d-i grub-installer/with_other_os boolean true
d-i grub-installer/bootdev string /dev/sda

# First-boot provisioning: install Docker + static host-only IP on first startup
d-i preseed/late_command string \
  mkdir -p /target/usr/local/sbin /target/etc/systemd/system ; \
  HOST_IP=$(awk 'BEGIN{RS=" "} /^url=http:/{split($0,a,"/"); split(a[3],b,":"); print b[1]}' /proc/cmdline) ; \
  wget -q -O /target/usr/local/sbin/firstboot-inception.sh \
       http://${HOST_IP}:8000/firstboot-inception.sh \
    && [ -s /target/usr/local/sbin/firstboot-inception.sh ] || exit 1 ; \
  chmod +x /target/usr/local/sbin/firstboot-inception.sh ; \
  printf '[Unit]\nDescription=First boot provisioning for Inception\nAfter=network-online.target\nWants=network-online.target\n\n[Service]\nType=oneshot\nExecStart=/usr/local/sbin/firstboot-inception.sh\nRemainAfterExit=no\n\n[Install]\nWantedBy=multi-user.target\n' \
    > /target/etc/systemd/system/firstboot-inception.service ; \
  in-target systemctl enable firstboot-inception.service

d-i finish-install/reboot_in_progress note